<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*" %>
<%!
private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Proveedores | ServiciosHogar</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body>
<header class="navbar"><a class="logo" href="${pageContext.request.contextPath}/"><span class="logo-icon">S</span>ServiciosHogar</a><nav><a href="${pageContext.request.contextPath}/servicios">Servicios</a><a href="${pageContext.request.contextPath}/panel">Mi panel</a><a href="${pageContext.request.contextPath}/login.jsp">Iniciar sesión</a></nav></header>
<main class="section"><span class="eyebrow">PROFESIONALES DE CONFIANZA</span><h1>Encuentra al especialista que necesitas</h1><p class="muted">Compara categorías, conoce la experiencia de cada proveedor y elige quién puede ayudarte en casa.</p>
<% if(request.getAttribute("errorPerfiles") != null) { %><div class="alert"><%=esc((String)request.getAttribute("errorPerfiles"))%></div><% } %>
<div class="grid"><% List<Map<String,Object>> lista=(List<Map<String,Object>>)request.getAttribute("perfiles"); if(lista==null||lista.isEmpty()){ %><article class="card"><h3>Aún no hay proveedores</h3><p>Cuando se registren proveedores, sus perfiles aparecerán aquí.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/registro.jsp">Registrarme como proveedor</a></article><% }else for(Map<String,Object> p:lista){String nombre=(String)p.get("nombre");String desc=(String)p.get("descripcion");double promedio=((Number)p.get("promedio")).doubleValue();%>
<article class="card"><div class="profile-head"><% String foto=(String)p.get("fotoUrl"); if(foto!=null&&!foto.isBlank()){ %><img class="avatar provider-photo" src="<%=request.getContextPath()+esc(foto)%>" alt="Foto de <%=esc(nombre)%>"><% } else { %><div class="avatar"><%=nombre.isEmpty()?"P":esc(nombre.substring(0,1).toUpperCase())%></div><% } %><div><h3><%=esc(nombre)%></h3><span class="tag"><%=Boolean.TRUE.equals(p.get("disponible"))?"Disponible para trabajos":"No disponible por ahora"%></span></div></div>
<div class="provider-category"><span class="category-icon">⌂</span><div><small>ESPECIALIDAD</small><strong><%=esc((String)p.get("categorias"))%></strong></div></div>
<p class="provider-description"><strong>Sobre el proveedor</strong><br><%=desc==null||desc.isBlank()?"Este proveedor aún no ha añadido una descripción a su perfil.":esc(desc)%></p>
<p>Experiencia: <strong><%=p.get("experiencia")%> años</strong></p><p>Tarifa referencial: <strong class="price">S/ <%=p.get("tarifa")%></strong></p>
<p class="rating">★ <%=String.format(java.util.Locale.US,"%.1f",promedio)%> / 5 <span class="muted">(<%=p.get("resenas")%> reseñas)</span></p>
<div class="card-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/servicios?q=<%=java.net.URLEncoder.encode(nombre,"UTF-8")%>">Ver servicios</a><% if(Boolean.TRUE.equals(p.get("disponible"))){%><a class="btn btn-outline" href="${pageContext.request.contextPath}/servicios?q=<%=java.net.URLEncoder.encode(nombre,"UTF-8")%>">Contratar</a><%}%></div></article>
<% } %></div></main><footer class="footer"><strong>ServiciosHogar</strong><span>Elige con información y confianza.</span></footer></body></html>